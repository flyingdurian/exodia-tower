# Exodia Tower: no model developer API key required for local operation.
HOST=127.0.0.1
PORT=8765
WEB_SESSIONS_ENABLED=true
WEB_HEADLESS=false
WEB_MODEL_DEFAULT=chatgpt
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-repository
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=
YOUTUBE_ACCESS_TOKEN=
GMAIL_ACCESS_TOKEN=
BROWSER_ENABLED=false
BROWSER_ALLOWED_HOSTS=
BROWSER_READ_URL=
INDEX_ROOT=.
DENSE_SEARCH=false
USER_STATE=

# Automatic inference without cloud developer keys: install local Ollama.
OLLAMA_MODEL=llama3.2:3b

# Opt-in public web page reading. Explicitly list every public HTTPS host you permit.
RESEARCH_ALLOWED_HOSTS=en.wikipedia.org

# Optional compatibility diagnostics: use your browser's ACTUAL user agent from chrome://version.
# Custom UA does not bypass Google account security checks; leave blank unless debugging.
EXODIA_BROWSER_USER_AGENT=
