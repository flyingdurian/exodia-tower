# Local-only dashboard and optional network integrations
HOST=127.0.0.1
PORT=8765
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GITHUB_TOKEN=
GITHUB_REPO=your-username/your-repository
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=
YOUTUBE_ACCESS_TOKEN=
GMAIL_ACCESS_TOKEN=
BROWSER_ENABLED=false
BROWSER_ALLOWED_HOSTS=
BROWSER_READ_URL=
# Restrict all indexing to this directory. Defaults to project root.
INDEX_ROOT=.
# Never set this when publicly exposing the app without authentication.

DENSE_SEARCH=false
# Optional short operator context added to model prompts (sent to API only when asking the model).
USER_STATE=
